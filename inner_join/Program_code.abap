REPORT ZINNERJOIN1.

TABLES: LFA1,EKKO.

SELECTION-SCREEN:BEGIN OF BLOCK B2 WITH FRAME TITLE TEXT-000.
  SELECT-OPTIONS: N_LIFNR FOR LFA1-LIFNR OBLIGATORY.
  SELECTION-SCREEN:END OF BLOCK B2.

TYPES:
BEGIN OF TY_STR,
 LIFNR TYPE  LIFNR,
 NAME1 TYPE NAME1_GP,
 EBELN TYPE EBELN,
 AEDAT TYPE ERDAT,
 ZTERM TYPE DZTERM,
  END OF TY_STR.

  DATA:IT TYPE TABLE OF TY_STR,
  WA TYPE       TY_STR.

SELECT LFA1~LIFNR LFA1~NAME1
       EKKO~EBELN EKKO~AEDAT EKKO~ZTERM
       INTO TABLE IT UP TO 20 ROWS
       FROM LFA1 INNER JOIN EKKO
       ON LFA1~LIFNR = EKKO~LIFNR
       WHERE LFA1~LIFNR IN N_LIFNR.

 ULINE.
 WRITE:/ 'LIFNR' COLOR 1,
 10 'NAME1' COLOR 3,
 40 'EBELN' COLOR 4,
 60 'AEDAT' COLOR 5,
 80 'ZTERM' COLOR 6.
 ULINE.

 LOOP AT IT INTO WA.
WRITE:/ WA-LIFNR,
      10 WA-NAME1,
      40 WA-EBELN,
      60 WA-AEDAT,
      80 WA-ZTERM.
ENDLOOP.
