REPORT ZBOOK3_PROJECTION.

*TABLES: ZBOOK3_PVIEW.

*DATA:BEGIN OF wa,
*      BOOK_ID TYPE ZBID,
*      BOOK_NAME TYPE ZBNAME,
*      PRICE TYPE ZPRICE11,
